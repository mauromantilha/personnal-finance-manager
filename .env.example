# ── IA ──────────────────────────────────────────────────────────────────────────
# Groq LLM API (llama-3.3-70b-versatile). Get yours: https://console.groq.com/keys
GROQ_API_KEY="gsk_YOUR_KEY_HERE"

# ── Cloudflare ───────────────────────────────────────────────────────────────────
# API Token com permissões: D1:Edit, R2:Edit, Access:Edit, Pages:Edit, DNS:Edit
# Crie em: dash.cloudflare.com/profile/api-tokens
CF_API_TOKEN="YOUR_CF_API_TOKEN"

# ── Email (Resend) ────────────────────────────────────────────────────────────────
# Necessário para envio de email de boas-vindas. Get yours: https://resend.com/api-keys
RESEND_API_KEY="re_YOUR_KEY_HERE"

# ── Segredos da aplicação ─────────────────────────────────────────────────────────
# APP_SECRET: assina tokens internos. Gere com: openssl rand -hex 32
APP_SECRET="CHANGE_ME_RANDOM_HEX_32_CHARS"

# CPF_SALT: salt HMAC para hash de CPF no cadastro. Gere com: openssl rand -hex 32
# Se ausente, usa ADMIN_PASSWORD como fallback (inseguro — defina sempre em produção)
CPF_SALT="CHANGE_ME_RANDOM_HEX_32_CHARS"

# ADMIN_PASSWORD: senha de acesso ao painel admin (CF Access).
# Use valor forte e aleatório em produção.
ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD"

# ── URLs ──────────────────────────────────────────────────────────────────────────
APP_URL="https://financas.mksbrasil.com"
