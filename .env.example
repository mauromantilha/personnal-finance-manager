# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# APP_PASSWORD: Password required to access the dashboard.
# Default (dev only): mks2026
APP_PASSWORD="CHANGE_ME_STRONG_PASSWORD"

# APP_SECRET: Secret key used to sign session tokens (HMAC-SHA256).
# Generate a strong random value: openssl rand -hex 32
APP_SECRET="CHANGE_ME_RANDOM_HEX_SECRET"
