# GROQ_API_KEY: Required for Groq LLM API calls (llama-3.3-70b-versatile).
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY="gsk_YOUR_KEY_HERE"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://financas.mksbrasil.com"

# APP_PASSWORD: Password required to access the dashboard.
# Default (dev only): mks2026
APP_PASSWORD="CHANGE_ME_STRONG_PASSWORD"

# APP_SECRET: Secret key used to sign session tokens (HMAC-SHA256).
# Generate a strong random value: openssl rand -hex 32
APP_SECRET="CHANGE_ME_RANDOM_HEX_SECRET"

# Cloudflare D1 + R2 — choose ONE of the two options below:

# Option A (recommended for production): permanent API token from dash.cloudflare.com/profile/api-tokens
# Permissions needed: D1:Edit, R2:Edit
# CLOUDFLARE_API_TOKEN="YOUR_CF_API_TOKEN"

# Option B (dev/tunnel): wrangler OAuth refresh token (auto-renewed)
# Run `wrangler login` then copy refresh_token from ~/.config/.wrangler/config/default.toml
# CF_REFRESH_TOKEN="YOUR_WRANGLER_REFRESH_TOKEN"
